# Copy this file to .env and fill in real values. Never commit .env.

# Fast2SMS API key (fast2sms.com dashboard -> Dev API). Required for the
# consultation form to notify the clerk / client by SMS.
FAST2SMS_API_KEY=

# Optional override for the clerk's SMS number (10-digit Indian mobile,
# no country code). Defaults to chambers.clerk.phone in chambers.json.
CLERK_SMS_NUMBER=9573458794
