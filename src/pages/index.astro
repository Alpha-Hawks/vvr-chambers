---
// Brief & Gavel — Legal Advocate Studio
import CourtStatusClock from "../components/CourtStatusClock.astro";
import HeroSection from "../components/HeroSection.astro";
import ProfileSection from "../components/ProfileSection.astro";
import PracticeDossier from "../components/PracticeDossier.astro";
import ChambersRollPreview from "../components/ChambersRollPreview.astro";
import ConsultationModal from "../components/ConsultationModal.astro";
import BackToTop from "../components/BackToTop.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Brief & Gavel — Vimal Vasireddy, Advocate practice, High Court of Telangana & NCLT" />
  <title>Brief &amp; Gavel — Vimal Vasireddy | Legal Advocate Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="site-shell">
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <a class="brand-lockup" href="#top" aria-label="Brief and Gavel home">
          <img class="brand-mark" src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-logo_2fd75830.png" alt="Brief and Gavel mark" width="53" height="53" />
          <span>Brief <small>&amp; Gavel</small></span>
        </a>

        <CourtStatusClock />

        <nav class="desk-nav" id="desk-nav" aria-label="Main navigation">
          <a href="#profile">Profile</a>
          <a href="#practice">Practice</a>
          <a href="#approach">Approach</a>
          <a href="/chambers">The Roll</a>
          <a href="#contact">Contact</a>
        </nav>

        <button class="header-cta consultation-trigger" type="button">Request a consult ↗</button>

        <button class="menu-toggle" id="menu-toggle" aria-label="Open navigation" aria-expanded="false">
          <span class="menu-symbol-frame" aria-hidden="true">
            <video id="menu-video" class="menu-symbol-video" src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-animated-menu_4ca20c15.mp4" muted playsinline preload="auto"></video>
            <img class="menu-symbol-fallback" src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-video-menu-symbol_e43d4c99.png" alt="" />
          </span>
        </button>
      </div>

      <div class="scroll-progress-track" aria-hidden="true">
        <div class="scroll-progress-bar" id="scroll-progress"></div>
      </div>

      <nav class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation">
        <a href="#profile">Profile</a>
        <a href="#practice">Practice</a>
        <a href="#approach">Approach</a>
        <a href="/chambers">The Roll</a>
        <a href="#contact">Contact</a>
        <button class="header-cta consultation-trigger" type="button">Request a consultation ↗</button>
      </nav>
    </header>

    <main id="top">
      <!-- 1. Hero Section -->
      <HeroSection />

      <!-- 2. Advocate Profile & Animated Stats -->
      <ProfileSection />

      <!-- Quick Index Nav -->
      <nav class="quick-index reveal-init" aria-label="Page highlights">
        <a class="index-item" href="#profile">
          <span class="stamp">01</span>
          <div><span>Profile</span><strong>The advocate</strong></div>
        </a>
        <a class="index-item" href="#practice">
          <span class="stamp">02</span>
          <div><span>Practice</span><strong>Where we can help</strong></div>
        </a>
        <button class="index-item consultation-trigger" type="button">
          <span class="stamp">03</span>
          <div><span>First step</span><strong>Request a consult</strong></div>
        </button>
      </nav>

      <!-- 3. Interactive Practice Dossier -->
      <PracticeDossier />

      <!-- 4. Working Method & Approach -->
      <section class="content-section approach-section" id="approach">
        <div class="approach-image reveal-scale">
          <img src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-objects_07d4bc57.jpg" alt="A gavel, scale, pen and case file arranged on an advocate’s desk" width="600" height="450" loading="lazy" />
          <span class="image-caption">The instruments of a considered argument</span>
        </div>

        <div class="approach-content reveal-init" data-delay="150">
          <div class="section-kicker">The working method</div>
          <h2 class="section-title">Bring the facts. We’ll build the <em>strategy.</em></h2>
          <p class="section-intro">
            Good advocacy feels calm because the hard preparation happens before the decisive moment. You should always understand the work, the reasons behind it, and the next choice in front of you.
          </p>

          <div class="principles">
            <article class="principle reveal-init" data-delay="100">
              <span class="principle-number">01</span>
              <div>
                <h3>Start with the record</h3>
                <p>The facts, dates, and documents tell us where the case actually stands before we decide where it needs to go.</p>
              </div>
            </article>

            <article class="principle reveal-init" data-delay="200">
              <span class="principle-number">02</span>
              <div>
                <h3>Make the options legible</h3>
                <p>You receive a plain-language view of realistic paths, risks, timing, and what each step asks of you.</p>
              </div>
            </article>

            <article class="principle reveal-init" data-delay="300">
              <span class="principle-number">03</span>
              <div>
                <h3>Act with purpose</h3>
                <p>Every filing, meeting, and negotiation is tied to a clear strategic objective—not activity for its own sake.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- 5. Chambers Roll Preview -->
      <ChambersRollPreview />

      <!-- 6. Contact Band -->
      <section class="contact-band" id="contact">
        <div class="contact-band-inner reveal-init">
          <div class="section-kicker">Open a conversation</div>
          <h2>A considered next step is often the <em>most important one.</em></h2>
          <button class="desk-button consultation-trigger" type="button">Request a consultation ↗</button>
        </div>
        <div class="contact-details reveal-init" data-delay="150">
          <span>Private consultations by appointment</span>
          <span>Discreet first conversations</span>
          <span>In-person and online meetings</span>
          <span>By appointment</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="footer-brand" href="#top">
        <img src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-logo_2fd75830.png" alt="Brief and Gavel mark" width="34" height="34" />
        Brief &amp; Gavel
      </a>
      <p>
        © 2026 Brief &amp; Gavel. Information on this site is general in nature and is not legal advice. A consultation helps determine whether we can assist with your particular matter. <a href="#top">Back to top</a>
      </p>
    </footer>
  </div>

  <ConsultationModal />
  <BackToTop />

  <script is:inline>
    // Header Drawer & Consultation Modal Event Controller
    (function initUIControls() {
      const menuButton = document.querySelector('#menu-toggle');
      const drawer = document.querySelector('#mobile-drawer');
      const menuVideo = document.querySelector('#menu-video');

      function resetMenuAnimation() {
        if (menuVideo) { menuVideo.pause(); menuVideo.currentTime = 0; }
      }

      function closeMenu() {
        if (!drawer || !menuButton) return;
        drawer.classList.remove('open');
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Open navigation');
        resetMenuAnimation();
      }

      if (menuButton && drawer) {
        menuButton.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('open');
          if (isOpen) return closeMenu();
          if (menuVideo) { menuVideo.pause(); menuVideo.currentTime = 0; menuVideo.play().catch(() => {}); }
          drawer.classList.add('open');
          menuButton.setAttribute('aria-expanded', 'true');
          menuButton.setAttribute('aria-label', 'Close navigation');
        });
        drawer.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      }

      const modal = document.querySelector('#consultation-modal');
      const modalClose = document.querySelector('#modal-close');
      const consultationForm = document.querySelector('#consultation-form');
      const formMessage = document.querySelector('#form-message');

      const closeModal = () => modal && modal.classList.remove('open');

      document.querySelectorAll('.consultation-trigger').forEach(btn => {
        btn.addEventListener('click', () => modal && modal.classList.add('open'));
      });

      if (modalClose) modalClose.addEventListener('click', closeModal);
      if (modal) {
        modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });
      }

      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') { closeModal(); closeMenu(); }
      });

      if (consultationForm && formMessage) {
        consultationForm.addEventListener('submit', event => {
          event.preventDefault();
          formMessage.classList.add('show');
        });
      }
    })();

    /* ============================================================
       Scroll Reveal, Progress & ScrollSpy Controller
       ============================================================ */
    (function initScrollController() {
      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealElements = document.querySelectorAll('.reveal-init, .reveal-left, .reveal-right, .reveal-scale');
      const progressBar = document.querySelector('#scroll-progress');
      const header = document.querySelector('#site-header') || document.querySelector('.site-header');
      const backToTop = document.querySelector('#back-to-top');
      const heroSlip = document.querySelector('#hero-brief-slip');
      const navLinks = document.querySelectorAll('.desk-nav a');

      // 1. IntersectionObserver for Reveal Animations
      if (!isReducedMotion && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });

        revealElements.forEach(el => revealObserver.observe(el));
        setTimeout(() => revealElements.forEach(el => el.classList.add('is-revealed')), 1400);
      } else {
        revealElements.forEach(el => el.classList.add('is-revealed'));
      }

      // 2. Throttled Scroll Listener (RAF)
      let ticking = false;
      const sections = ['profile', 'practice', 'approach', 'contact'].map(id => ({
        id,
        el: document.getElementById(id)
      })).filter(s => s.el !== null);

      function onScroll() {
        const scrollY = window.scrollY || window.pageYOffset;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

        if (progressBar && maxScroll > 0) {
          const progress = Math.min(Math.max((scrollY / maxScroll) * 100, 0), 100);
          progressBar.style.width = progress + '%';
        }

        if (header) {
          if (scrollY > 30) header.classList.add('scrolled');
          else header.classList.remove('scrolled');
        }

        if (backToTop) {
          if (scrollY > 350) backToTop.classList.add('show');
          else backToTop.classList.remove('show');
        }

        if (!isReducedMotion && heroSlip && window.innerWidth > 900) {
          if (scrollY < 800) {
            const slipShift = scrollY * 0.07;
            heroSlip.style.transform = `rotate(-5deg) translateY(${-slipShift}px)`;
          }
        }

        if (navLinks.length > 0 && sections.length > 0) {
          let currentActiveId = '';
          const scrollMarker = scrollY + 160;
          for (let i = sections.length - 1; i >= 0; i--) {
            if (sections[i].el.offsetTop <= scrollMarker) {
              currentActiveId = sections[i].id;
              break;
            }
          }
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (currentActiveId && (href === `#${currentActiveId}` || href.endsWith(`#${currentActiveId}`))) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        }

        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });

      onScroll();

      if (backToTop) {
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    })();
  </script>
</body>
</html>
