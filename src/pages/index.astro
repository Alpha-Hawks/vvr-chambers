    document.querySelectorAll('.consultation-trigger').forEach(button => button.addEventListener('click', () => modal.classList.add('open')));
    document.querySelector('#modal-close').addEventListener('click', closeModal);
    modal.addEventListener('click', event => { if (event.target === modal) closeModal(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') { closeModal(); closeMenu(); } });
    document.querySelector('#consultation-form').addEventListener('submit', event => {
      event.preventDefault();
      document.querySelector('#form-message').classList.add('show');
    });

    // 6. Scroll Controllers & Counter Animation
    (function initScrollEffects() {
      const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealElements = document.querySelectorAll('.reveal-init, .reveal-left, .reveal-right, .reveal-scale');
      const progressBar = document.querySelector('#scroll-progress');
      const header = document.querySelector('#site-header');
      const backToTop = document.querySelector('#back-to-top');
      const statNums = document.querySelectorAll('.stat-num');
      let statsCounted = false;

      // Scroll reveal
      if (!isReducedMotion && 'IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealElements.forEach(el => revealObserver.observe(el));
      } else {
        revealElements.forEach(el => el.classList.add('is-revealed'));
      }

      // Animated Number Counters
      function animateCounters() {
        if (statsCounted) return;
        statsCounted = true;
        statNums.forEach(numEl => {
          const target = parseInt(numEl.getAttribute('data-target'), 10);
          let current = 0;
          const step = Math.max(1, Math.ceil(target / 40));
          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              numEl.textContent = target + (target === 100 ? '%' : '+');
              clearInterval(timer);
            } else {
              numEl.textContent = current;
            }
          }, 30);
        });
      }

      // Scroll listener (RAF throttled)
      let ticking = false;
      function onScroll() {
        const scrollY = window.scrollY || window.pageYOffset;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

        if (progressBar && maxScroll > 0) {
          progressBar.style.width = Math.min(100, Math.max(0, (scrollY / maxScroll) * 100)) + '%';
        }

        if (header) {
          if (scrollY > 30) header.classList.add('scrolled');
          else header.classList.remove('scrolled');
        }

        if (backToTop) {
          if (scrollY > 380) backToTop.classList.add('show');
          else backToTop.classList.remove('show');
        }

        const profileSection = document.getElementById('profile');
        if (profileSection && !statsCounted) {
          const rect = profileSection.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.8) {
            animateCounters();
          }
        }

        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });

      onScroll();

      if (backToTop) {
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
    })();

    // 7. VengeanceUI Scroll Dissolve Reveal Shader Controller
    (function initScrollDissolveReveal() {
      const container = document.getElementById('scroll-dissolve-container');
      const canvas = document.getElementById('dissolve-canvas');
      const fallbackImg = document.getElementById('hero-fallback-img');
      if (!container || !canvas || typeof THREE === 'undefined') return;

      const imageFront = "https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-hero_fb3554c6.jpg";
      const imageBack = "https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-objects_07d4bc57.jpg";

      const coverVertexShader = `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `;

      const coverFragmentShader = `
        uniform sampler2D uTexture;
        uniform vec2 uResolution;
        uniform vec2 uImageResolution;
        uniform float uDissolve;
        uniform vec2 uCenter;
        uniform float uTime;
        uniform float uGrayscale;
        uniform float uEdgeIntensity;
        uniform float uEdgeBrightness;
        varying vec2 vUv;

        float getLuminance(vec3 color) {
          return dot(color, vec3(0.299, 0.587, 0.114));
        }

        float sobel(sampler2D tex, vec2 uv, vec2 texelSize) {
          vec3 c00 = texture2D(tex, uv + vec2(-1.0, -1.0) * texelSize).rgb;
          vec3 c01 = texture2D(tex, uv + vec2(-1.0,  0.0) * texelSize).rgb;
          vec3 c02 = texture2D(tex, uv + vec2(-1.0,  1.0) * texelSize).rgb;
          vec3 c10 = texture2D(tex, uv + vec2( 0.0, -1.0) * texelSize).rgb;
          vec3 c12 = texture2D(tex, uv + vec2( 0.0,  1.0) * texelSize).rgb;
          vec3 c20 = texture2D(tex, uv + vec2( 1.0, -1.0) * texelSize).rgb;
          vec3 c21 = texture2D(tex, uv + vec2( 1.0,  0.0) * texelSize).rgb;
          vec3 c22 = texture2D(tex, uv + vec2( 1.0,  1.0) * texelSize).rgb;

          float l00 = getLuminance(c00);
          float l01 = getLuminance(c01);
          float l02 = getLuminance(c02);
          float l10 = getLuminance(c10);
          float l12 = getLuminance(c12);
          float l20 = getLuminance(c20);
          float l21 = getLuminance(c21);
          float l22 = getLuminance(c22);

          float gx = -l00 + l02 - 2.0*l10 + 2.0*l12 - l20 + l22;
          float gy = -l00 - 2.0*l01 - l02 + l20 + 2.0*l21 + l22;

          return sqrt(gx * gx + gy * gy);
        }

        float hash(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }

        float noise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }

        float fbm(vec2 p) {
          float value = 0.0;
          float amplitude = 0.5;
          float frequency = 1.0;
          
          for (int i = 0; i < 5; i++) {
            value += amplitude * noise(p * frequency);
            amplitude *= 0.5;
            frequency *= 2.0;
          }
          
          return value;
        }

        void main() {
          vec2 ratio = vec2(
            min((uResolution.x / uResolution.y) / (uImageResolution.x / uImageResolution.y), 1.0),
            min((uResolution.y / uResolution.x) / (uImageResolution.y / uImageResolution.x), 1.0)
          );

          vec2 uv = vec2(
            vUv.x * ratio.x + (1.0 - ratio.x) * 0.5,
            vUv.y * ratio.y + (1.0 - ratio.y) * 0.5
          );

          vec4 texColor = texture2D(uTexture, uv);
          
          float gray = getLuminance(texColor.rgb);
          vec3 grayscaleColor = vec3(gray);
          texColor.rgb = mix(texColor.rgb, grayscaleColor, uGrayscale);
          
          vec2 centeredUv = vUv - uCenter;
          float aspect = uResolution.x / uResolution.y;
          centeredUv.x *= aspect;
          float dist = length(centeredUv);
          
          float angle = atan(centeredUv.y, centeredUv.x);
          
          float noiseScale = 6.0;
          vec2 pixelatedUv = floor(vUv * uResolution / noiseScale) * noiseScale / uResolution;
          float blockNoise = fbm(pixelatedUv * 100.0) * 0.15;
          
          float angularNoise = fbm(vec2(angle * 5.0, 0.0)) * 0.15;
          
          float totalNoise = blockNoise + angularNoise;
          float noisyDist = dist + totalNoise;
          
          float maxDist = length(vec2(aspect * 0.5, 0.5));
          float normalizedDist = noisyDist / maxDist;
          
          float dissolveThreshold = uDissolve * 1.5; 
          
          vec2 texelSize = 1.0 / uResolution;
          float edge = sobel(uTexture, uv, texelSize);
          
          edge = pow(edge, 0.7) * 2.0;
          edge = clamp(edge, 0.0, 1.0);
          
          float dissolveMask = smoothstep(dissolveThreshold - 0.03, dissolveThreshold, normalizedDist);
          
          vec3 edgeColor = vec3(1.0, 1.0, 1.0);
          
          vec3 baseColor = mix(texColor.rgb, vec3(0.0), uGrayscale);
          vec3 finalColor = baseColor;
          
          float edgeGlowIntensity = uEdgeIntensity * 2.0;
          float edgeGlow = edge * edgeGlowIntensity * (1.0 + uGrayscale * 3.0);
          finalColor += edgeColor * edgeGlow * uEdgeBrightness;
          
          float edgeZoneWidth = 0.15 * (1.0 - uDissolve) + 0.02;
          float edgeZone = smoothstep(dissolveThreshold - edgeZoneWidth, dissolveThreshold - edgeZoneWidth + 0.04, normalizedDist) * 
                           smoothstep(dissolveThreshold + 0.02, dissolveThreshold - 0.02, normalizedDist);
          float sparkle = hash(floor(vUv * uResolution / 4.0)) * edgeZone;
          
          float edgeBrightness = (1.0 - uDissolve) * uEdgeBrightness * (1.0 + uGrayscale * 2.0);
          finalColor += vec3(sparkle * 3.0 * edgeBrightness);
          
          float alpha = dissolveMask * texColor.a;

          gl_FragColor = vec4(finalColor, alpha);
        }
      `;

      const coverFragmentShaderReverse = `
        uniform sampler2D uTexture;
        uniform vec2 uResolution;
        uniform vec2 uImageResolution;
        uniform float uDissolve;
        uniform vec2 uCenter;
        uniform float uTime;
        uniform float uBrightness;
        uniform float uEdgeIntensity;
        uniform float uDarkness;
        uniform float uGrayscale;
        varying vec2 vUv;

        float getLuminance(vec3 color) {
          return dot(color, vec3(0.299, 0.587, 0.114));
        }

        float sobel(sampler2D tex, vec2 uv, vec2 texelSize) {
          vec3 c00 = texture2D(tex, uv + vec2(-1.0, -1.0) * texelSize).rgb;
          vec3 c01 = texture2D(tex, uv + vec2(-1.0,  0.0) * texelSize).rgb;
          vec3 c02 = texture2D(tex, uv + vec2(-1.0,  1.0) * texelSize).rgb;
          vec3 c10 = texture2D(tex, uv + vec2( 0.0, -1.0) * texelSize).rgb;
          vec3 c12 = texture2D(tex, uv + vec2( 0.0,  1.0) * texelSize).rgb;
          vec3 c20 = texture2D(tex, uv + vec2( 1.0, -1.0) * texelSize).rgb;
          vec3 c21 = texture2D(tex, uv + vec2( 1.0,  0.0) * texelSize).rgb;
          vec3 c22 = texture2D(tex, uv + vec2( 1.0,  1.0) * texelSize).rgb;

          float l00 = getLuminance(c00);
          float l01 = getLuminance(c01);
          float l02 = getLuminance(c02);
          float l10 = getLuminance(c10);
          float l12 = getLuminance(c12);
          float l20 = getLuminance(c20);
          float l21 = getLuminance(c21);
          float l22 = getLuminance(c22);

          float gx = -l00 + l02 - 2.0*l10 + 2.0*l12 - l20 + l22;
          float gy = -l00 - 2.0*l01 - l02 + l20 + 2.0*l21 + l22;

          return sqrt(gx * gx + gy * gy);
        }

        void main() {
          vec2 ratio = vec2(
            min((uResolution.x / uResolution.y) / (uImageResolution.x / uImageResolution.y), 1.0),
            min((uResolution.y / uResolution.x) / (uImageResolution.y / uImageResolution.x), 1.0)
          );

          vec2 uv = vec2(
            vUv.x * ratio.x + (1.0 - ratio.x) * 0.5,
            vUv.y * ratio.y + (1.0 - ratio.y) * 0.5
          );

          vec4 texColor = texture2D(uTexture, uv);
          
          float gray = getLuminance(texColor.rgb);
          vec3 grayscaleColor = vec3(gray);
          texColor.rgb = mix(texColor.rgb, grayscaleColor, uGrayscale);
          
          vec2 texelSize = 1.0 / uResolution;
          float edge = sobel(uTexture, uv, texelSize);
          
          edge = pow(edge, 0.7) * 2.0;
          edge = clamp(edge, 0.0, 1.0);
          
          vec3 edgeColor = vec3(1.0, 1.0, 1.0);
          
          vec3 darkBase = vec3(0.0);
          vec3 baseColor = mix(texColor.rgb, darkBase, uDarkness);
          
          float edgeGlow = edge * uEdgeIntensity * 2.0;
          baseColor += edgeColor * edgeGlow;
          
          vec3 finalColor = clamp(baseColor, 0.0, 1.0);

          gl_FragColor = vec4(finalColor, texColor.a);
        }
      `;

      let width = container.clientWidth || window.innerWidth;
      let height = container.clientHeight || window.innerHeight;

      let renderer;
      try {
        renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: false, alpha: true });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      } catch (err) {
        console.warn('WebGL not supported for scroll-dissolve-reveal:', err);
        return;
      }

      const scene = new THREE.Scene();
      const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10);
      camera.position.z = 1;

      const uniforms1 = {
        uTexture: { value: null },
        uResolution: { value: new THREE.Vector2(width, height) },
        uImageResolution: { value: new THREE.Vector2(1920, 1080) },
        uDissolve: { value: 0.0 },
        uCenter: { value: new THREE.Vector2(0.5, 0.5) },
        uTime: { value: 0.0 },
        uGrayscale: { value: 0.0 },
        uEdgeIntensity: { value: 0.0 },
        uEdgeBrightness: { value: 1.0 }
      };

      const uniforms2 = {
        uTexture: { value: null },
        uResolution: { value: new THREE.Vector2(width, height) },
        uImageResolution: { value: new THREE.Vector2(1920, 1080) },
        uDissolve: { value: 0.0 },
        uCenter: { value: new THREE.Vector2(0.5, 0.5) },
        uTime: { value: 0.0 },
        uBrightness: { value: 0.0 },
        uEdgeIntensity: { value: 0.6 },
        uDarkness: { value: 1.0 },
        uGrayscale: { value: 1.0 }
      };

      const materialBack = new THREE.ShaderMaterial({
        vertexShader: coverVertexShader,
        fragmentShader: coverFragmentShaderReverse,
        uniforms: uniforms2,
        transparent: true
      });

      const materialFront = new THREE.ShaderMaterial({
        vertexShader: coverVertexShader,
        fragmentShader: coverFragmentShader,
        uniforms: uniforms1,
        transparent: true
      });

      const geometry = new THREE.PlaneGeometry(2, 2);
      const meshBack = new THREE.Mesh(geometry, materialBack);
      meshBack.position.z = -0.1;
      const meshFront = new THREE.Mesh(geometry, materialFront);
      meshFront.position.z = 0;

      scene.add(meshBack);
      scene.add(meshFront);

      let texFrontLoaded = false;
      let texBackLoaded = false;

      function checkLoaded() {
        if (texFrontLoaded && texBackLoaded) {
          canvas.classList.add('active');
          if (fallbackImg) fallbackImg.style.opacity = '0';
          updateScroll();
        }
      }

      const textureLoader = new THREE.TextureLoader();
      textureLoader.load(imageFront, (t) => {
        uniforms1.uTexture.value = t;
        if (t.image) uniforms1.uImageResolution.value.set(t.image.width || 1920, t.image.height || 1080);
        texFrontLoaded = true;
        checkLoaded();
      });

      textureLoader.load(imageBack, (t) => {
        uniforms2.uTexture.value = t;
        if (t.image) uniforms2.uImageResolution.value.set(t.image.width || 1920, t.image.height || 1080);
        texBackLoaded = true;
        checkLoaded();
      });

      const clock = new THREE.Clock();

      // Cinema Opening Scene elements
      const cinemaLayer = document.getElementById('hero-cinema-title-layer');
      const cinemaContainer = document.getElementById('cinema-title-container');
      const cinemaName = document.getElementById('cinema-advocate-name');
      const cinemaFlare = document.getElementById('cinema-flare');
      const cinemaGlow = document.getElementById('cinema-ambient-glow');
      const cinemaRules = document.querySelectorAll('.cinema-rule');
      const letterboxTop = document.querySelector('.cinema-letterbox-top');
      const letterboxBottom = document.querySelector('.cinema-letterbox-bottom');
      const heroContentLayer = document.querySelector('.hero-content-layer');
      const scrollIndicator = document.querySelector('.hero-scroll-indicator');

      function updateScroll() {
        const wrapper = document.getElementById('hero-pinned');
        if (!wrapper) return;
        const rect = wrapper.getBoundingClientRect();
        const totalScrollable = wrapper.clientHeight - window.innerHeight;
        const scrolled = -rect.top;
        
        let progress = Math.max(0, Math.min(1, scrolled / (totalScrollable > 0 ? totalScrollable : 1)));

        const time = clock.getElapsedTime();

        // 1. WebGL Dissolve Uniforms
        uniforms1.uTime.value = time;
        uniforms1.uDissolve.value = progress;
        uniforms1.uGrayscale.value = Math.min(1.0, progress / 0.4);
        uniforms1.uEdgeIntensity.value = progress * 0.5;
        uniforms1.uEdgeBrightness.value = 1.0 - progress;

        uniforms2.uTime.value = time;
        const accel = Math.min(1.0, progress * 1.1);
        uniforms2.uEdgeIntensity.value = 0.6 * (1.0 - accel);
        uniforms2.uDarkness.value = 1.0 - accel;
        uniforms2.uGrayscale.value = 1.0 - accel;

        renderer.render(scene, camera);

        // 2. Initial Hero Copy Fade-out (0.00 -> 0.20)
        if (heroContentLayer) {
          const heroFade = Math.max(0, 1 - progress / 0.18);
          heroContentLayer.style.opacity = heroFade;
          heroContentLayer.style.transform = `translateY(${-progress * 130}px) scale(${1 - progress * 0.08})`;
          heroContentLayer.style.filter = progress > 0.02 ? `blur(${progress * 14}px)` : 'none';
          heroContentLayer.style.pointerEvents = (heroFade > 0.05) ? 'auto' : 'none';
        }

        if (scrollIndicator) {
          scrollIndicator.style.opacity = Math.max(0, 1 - progress * 5);
        }

        // 3. Cinematic Advocate Name Reveal Scene (0.15 -> 0.88)
        if (cinemaLayer && cinemaContainer) {
          const cinemaStart = 0.15;
          const cinemaPeakStart = 0.36;
          const cinemaPeakEnd = 0.68;
          const cinemaEnd = 0.88;

          if (progress >= cinemaStart && progress <= cinemaEnd) {
            let cinemaOpacity = 0;
            let cinemaScale = 0.90;
            let letterSpacing = 0.16;
            let flareOpacity = 0;
            let flareX = 0;
            let letterboxH = 0;

            if (progress < cinemaPeakStart) {
              // Entering Phase: dramatic film exposure, tracking outward, letterbox widening
              const t = (progress - cinemaStart) / (cinemaPeakStart - cinemaStart);
              const easeT = t * t * (3 - 2 * t);
              cinemaOpacity = easeT;
              cinemaScale = 0.90 + 0.10 * easeT;
              letterSpacing = 0.16 + 0.12 * easeT;
              flareOpacity = easeT * 0.95;
              flareX = -120 + 120 * easeT;
              letterboxH = Math.round(52 * easeT);
            } else if (progress <= cinemaPeakEnd) {
              // Peak Cinema Presence: majestic hold, subtle drift & shimmer
              const t = (progress - cinemaPeakStart) / (cinemaPeakEnd - cinemaPeakStart);
              cinemaOpacity = 1;
              cinemaScale = 1.00 + 0.04 * t;
              letterSpacing = 0.28 + 0.04 * t;
              flareOpacity = 0.90 + 0.10 * Math.sin(t * Math.PI);
              flareX = (t - 0.5) * 60;
              letterboxH = 52;
            } else {
              // Exit Phase: ethereal dissolve into profile
              const t = (progress - cinemaPeakEnd) / (cinemaEnd - cinemaPeakEnd);
              const easeT = t * t;
              cinemaOpacity = 1 - easeT;
              cinemaScale = 1.04 + 0.05 * easeT;
              letterSpacing = 0.32 + 0.06 * easeT;
              flareOpacity = (1 - easeT) * 0.8;
              flareX = 30 + 70 * easeT;
              letterboxH = Math.round(52 * (1 - easeT));
            }

            cinemaLayer.style.opacity = cinemaOpacity;
            cinemaContainer.style.transform = `scale(${cinemaScale})`;
            cinemaContainer.style.filter = cinemaOpacity < 0.92 ? `blur(${(1 - cinemaOpacity) * 6}px)` : 'none';

            if (cinemaName) {
              cinemaName.style.letterSpacing = `${letterSpacing}em`;
            }

            if (cinemaFlare) {
              cinemaFlare.style.opacity = flareOpacity;
              cinemaFlare.style.transform = `translate(calc(-50% + ${flareX}px), -50%) scaleX(${0.8 + flareOpacity * 0.4})`;
            }

            if (cinemaGlow) {
              cinemaGlow.style.opacity = cinemaOpacity * 0.9;
            }

            cinemaRules.forEach(rule => {
              rule.style.transform = `scaleX(${Math.min(1, cinemaOpacity * 1.2)})`;
            });

            if (letterboxTop && letterboxBottom) {
              letterboxTop.style.height = `${letterboxH}px`;
              letterboxBottom.style.height = `${letterboxH}px`;
            }
          } else {
            cinemaLayer.style.opacity = 0;
            if (letterboxTop && letterboxBottom) {
              letterboxTop.style.height = '0px';
              letterboxBottom.style.height = '0px';
            }
          }
        }
      }

      window.addEventListener('scroll', updateScroll, { passive: true });
      window.addEventListener('resize', () => {
        width = container.clientWidth || window.innerWidth;
        height = container.clientHeight || window.innerHeight;
        renderer.setSize(width, height);
        uniforms1.uResolution.value.set(width, height);
        uniforms2.uResolution.value.set(width, height);
        updateScroll();
      });

      updateScroll();
    })();
  </script>

  <script>
    // VengeanceUI Testimonials Card 3D Animation Controller
    (function initVengeanceTestimonials() {
      const container = document.getElementById('experience-v-testimonials');
      if (!container) return;

      const viewport = document.getElementById('v-card-stack');
      const cards = Array.from(viewport.querySelectorAll('.v-stack-card'));
      const prevBtn = document.getElementById('v-prev-btn');
      const nextBtn = document.getElementById('v-next-btn');
      const counterNum = document.getElementById('v-active-num');
      const eraBadge = document.getElementById('v-stage-era');
      const textStage = document.getElementById('v-text-stage');
      const titleEl = document.getElementById('v-stage-title');
      const descEl = document.getElementById('v-stage-desc');
      const tagsEl = document.getElementById('v-stage-tags');
      const chips = Array.from(document.querySelectorAll('.v-chip'));

      const milestonesData = [
        {
          era: '2012 — 2016',
          title: 'Fundamental Rights & <em>High Court Writs</em>',
          desc: 'Secured critical administrative stays and represented fundamental rights writ petitions before the High Court of Telangana.',
          tags: ['✓ Mandamus & Certiorari Writs', '✓ Administrative Stays', '✓ Public Law Advocacy']
        },
        {
          era: '2016 — 2019',
          title: 'Insolvency & <em>Corporate Governance</em>',
          desc: 'Advocated complex shareholder disputes and insolvency proceedings before National Company Law Tribunal (NCLT) benches.',
          tags: ['✓ IBC Insolvency Relief', '✓ Derivative Suits', '✓ Boardroom Restructuring']
        },
        {
          era: '2019 — 2022',
          title: 'High-Stakes Injunctions & <em>Property</em>',
          desc: 'Defended commercial titles and real estate assets across complex civil trials and appellate record submissions.',
          tags: ['✓ Specific Performance', '✓ Commercial Injunctions', '✓ Title Recovery']
        },
        {
          era: '2022 — Present',
          title: 'Institutional Arbitration & <em>Awards</em>',
          desc: 'Senior counsel in major commercial arbitrations, managing tribunal appointments through final high-value award enforcement.',
          tags: ['✓ Section 9 & 11 Relief', '✓ Award Enforcement', '✓ Institutional Rules']
        }
      ];

      let activeIndex = 0;
      let isAnimating = false;
      const total = cards.length;
      const rotations = [4, -2, -9, 7];

      function getCardTransform(index, currentActive) {
        const offset = index - currentActive;
        if (offset === 0) {
          return {
            transform: 'translate3d(0px, 0px, 0px) rotateZ(0deg) scale(1)',
            opacity: 1,
            zIndex: 100
          };
        } else if (offset > 0) {
          const x = offset * 18;
          const y = Math.abs(offset) * 6;
          const z = -140 * offset;
          const scale = 0.86 - offset * 0.04;
          const rot = rotations[index % 4];
          const opacity = Math.max(0.2, 0.65 - offset * 0.12);
          return {
            transform: `translate3d(${x}px, ${y}px, ${z}px) rotateZ(${rot}deg) scale(${scale})`,
            opacity: opacity,
            zIndex: 10 - offset
          };
        } else {
          return {
            transform: 'translate3d(-260px, 0px, -260px) rotateZ(-12deg) scale(0.75)',
            opacity: 0,
            zIndex: 2
          };
        }
      }

      function applyStaticTransforms() {
        cards.forEach((card, idx) => {
          const style = getCardTransform(idx, activeIndex);
          card.style.transform = style.transform;
          card.style.opacity = style.opacity;
          card.style.zIndex = style.zIndex;
        });
      }

      function goToSlide(newIndex, direction) {
        if (newIndex === activeIndex || isAnimating || newIndex < 0 || newIndex >= total) return;
        isAnimating = true;

        const prevIndex = activeIndex;
        activeIndex = newIndex;

        // Animate cards with Web Animations API matching VengeanceUI motion arc
        cards.forEach((card, idx) => {
          if (idx === newIndex) {
            // New Active Card: signature VengeanceUI 3D swooping flight
            card.style.zIndex = 100;
            const startOffset = idx - prevIndex;
            const startX = startOffset * 18;
            const startY = Math.abs(startOffset) * 6;
            const startZ = -140 * Math.abs(startOffset);
            const startRot = rotations[idx % 4];
            const startScale = 0.86 - Math.abs(startOffset) * 0.04;

            const midX = direction === 1 ? -220 : 220;
            const midRot = direction === 1 ? -6 : 6;

            card.animate([
              {
                transform: `translate3d(${startX}px, ${startY}px, ${startZ}px) rotateZ(${startRot}deg) scale(${startScale})`,
                opacity: 0.7
              },
              {
                transform: `translate3d(${midX}px, 0px, 150px) rotateZ(${midRot}deg) scale(1.05)`,
                opacity: 1,
                offset: 0.42
              },
              {
                transform: 'translate3d(0px, 0px, 0px) rotateZ(0deg) scale(1)',
                opacity: 1
              }
            ], {
              duration: 750,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards'
            });
          } else if (idx === prevIndex) {
            // Outgoing Card: swoops out
            const exitX = direction === 1 ? -260 : 260;
            const exitRot = direction === 1 ? -12 : 12;

            card.animate([
              {
                transform: 'translate3d(0px, 0px, 0px) rotateZ(0deg) scale(1)',
                opacity: 1
              },
              {
                transform: `translate3d(${exitX}px, 0px, -260px) rotateZ(${exitRot}deg) scale(0.75)`,
                opacity: 0
              }
            ], {
              duration: 650,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards'
            });
            card.style.zIndex = 5;
          } else {
            // Other cards in stack shift smoothly to their new depth positions
            const oldStyle = getCardTransform(idx, prevIndex);
            const targetStyle = getCardTransform(idx, activeIndex);
            card.style.zIndex = targetStyle.zIndex;

            card.animate([
              { transform: oldStyle.transform, opacity: oldStyle.opacity },
              { transform: targetStyle.transform, opacity: targetStyle.opacity }
            ], {
              duration: 600,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards'
            });
          }
        });

        // Update Text Stage with smooth fade & slide
        if (textStage) {
          textStage.classList.add('transitioning');
          setTimeout(() => {
            const data = milestonesData[activeIndex];
            if (eraBadge) eraBadge.innerHTML = `<span class="dot"></span>${data.era}`;
            if (counterNum) counterNum.textContent = String(activeIndex + 1).padStart(2, '0');
            if (titleEl) titleEl.innerHTML = data.title;
            if (descEl) descEl.textContent = data.desc;
            if (tagsEl) {
              tagsEl.innerHTML = data.tags.map(t => `<span class="v-tag-pill">${t}</span>`).join('');
            }
            textStage.classList.remove('transitioning');
          }, 220);
        }

        // Update Chips & Buttons
        chips.forEach((chip, i) => {
          if (i === activeIndex) {
            chip.classList.add('active');
          } else {
            chip.classList.remove('active');
          }
        });

        if (prevBtn) prevBtn.disabled = (activeIndex === 0);
        if (nextBtn) nextBtn.disabled = (activeIndex === total - 1);

        setTimeout(() => {
          isAnimating = false;
        }, 760);
      }

      // Button listeners
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (activeIndex > 0) goToSlide(activeIndex - 1, -1);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (activeIndex < total - 1) goToSlide(activeIndex + 1, 1);
        });
      }

      // Chips click
      chips.forEach((chip, idx) => {
        chip.addEventListener('click', () => {
          if (idx !== activeIndex) {
            goToSlide(idx, idx > activeIndex ? 1 : -1);
          }
        });
      });

      // Clicking any card directly in the 3D stack
      cards.forEach((card, idx) => {
        card.addEventListener('click', () => {
          if (idx !== activeIndex) {
            goToSlide(idx, idx > activeIndex ? 1 : -1);
          }
        });
      });

      // Touch swipe gestures
      let touchStartX = 0;
      viewport.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      viewport.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 45) {
          if (diff > 0 && activeIndex < total - 1) {
            goToSlide(activeIndex + 1, 1);
          } else if (diff < 0 && activeIndex > 0) {
            goToSlide(activeIndex - 1, -1);
          }
        }
      }, { passive: true });

      // Initialize
      applyStaticTransforms();
      if (prevBtn) prevBtn.disabled = true;
      if (nextBtn) nextBtn.disabled = (total <= 1);
    })();
  </script>
</body>

</html>
