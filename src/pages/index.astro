    // 1. Cinematic Opening Sequence
    window.addEventListener('DOMContentLoaded', () => {
      const loader = document.getElementById('cinematic-loader');
      setTimeout(() => loader.classList.add('loaded'), 100);
      setTimeout(() => loader.classList.add('done'), 1400);
    });

    // 2. Ambient Canvas Dust Particles
    (function initParticles() {
      const canvas = document.getElementById('particle-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const particles = Array.from({ length: 35 }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.5 + 0.5,
        dx: (Math.random() - 0.5) * 0.3,
        dy: (Math.random() - 0.5) * 0.3,
        alpha: Math.random() * 0.5 + 0.2
      }));

      function render() {
        ctx.clearRect(0, 0, width, height);
        particles.forEach(p => {
          p.x += p.dx;
          p.y += p.dy;
          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(197, 160, 89, ${p.alpha})`;
          ctx.fill();
        });
        requestAnimationFrame(render);
      }
      render();
    })();

    // 3. Practice Area Dossier State
    const areas = [
      ["01", "Constitutional Law", "Fundamental-rights petitions, writ jurisdiction, and public importance matters.", "Fundamental-rights petitions, writ jurisdiction, and public importance matters approached through precise preparation and considered advocacy.", ["Fundamental-rights petitions", "Writ jurisdiction", "Public importance matters"]],
      ["02", "Criminal Defence", "Bail, trial, and appellate representation grounded in meticulous case strategy.", "Bail, trial, and appellate representation grounded in meticulous case strategy and purposeful preparation at each stage.", ["Bail representation", "Trial strategy", "Appellate representation"]],
      ["03", "Civil Litigation", "Property, contract, and injunction disputes resolved with disciplined advocacy.", "Property, contract, and injunction disputes resolved with disciplined advocacy and close attention to the record.", ["Property disputes", "Contract disputes", "Injunction matters"]],
      ["04", "Corporate & Commercial", "Company disputes, regulatory matters, and advisory for institutions.", "Company disputes, regulatory matters, and practical advisory support for institutions and founders navigating commercial decisions.", ["Company disputes", "Regulatory matters", "Institutional advisory"]],
      ["05", "Arbitration", "Domestic and institutional arbitration, from appointment through enforcement.", "Domestic and institutional arbitration support from appointment through enforcement, organized around the matters in issue.", ["Domestic arbitration", "Institutional arbitration", "Enforcement"]],
      ["06", "Appellate Practice", "Focused appellate briefs and oral argument before superior courts.", "Focused appellate briefs and oral argument before superior courts, built on a structured record and framed legal questions.", ["Appellate briefs", "Oral argument", "Superior courts"]]
