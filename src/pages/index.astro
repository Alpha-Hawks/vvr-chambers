    function closeMenu() { drawer.classList.remove('open'); menuButton.setAttribute('aria-expanded', 'false'); }
    menuButton.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('open');
      if (isOpen) return closeMenu();
      drawer.classList.add('open'); menuButton.setAttribute('aria-expanded', 'true');
    });
    drawer.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

    // 5. Consultation Modal Handlers
    const modal = document.querySelector('#consultation-modal');
