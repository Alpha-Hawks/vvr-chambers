---
// CourtStatusClock.astro — Live IST Court Session Indicator
---

<div class="court-status-pill" id="court-status-pill" title="Indian Standard Time (IST)">
  <span class="status-dot"></span>
  <span class="status-text" id="status-text">TS High Court · In Session</span>
  <time class="status-clock" id="court-clock">10:30 IST</time>
</div>

<script is:inline>
  (function initCourtClock() {
    const clockEl = document.getElementById('court-clock');
    const textEl = document.getElementById('status-text');
    const pillEl = document.getElementById('court-status-pill');

    function updateClock() {
      const now = new Date();
      // Convert to IST (UTC +5:30)
      const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
      const istDate = new Date(utc + (3600000 * 5.5));
      
      const hours = istDate.getHours();
      const minutes = istDate.getMinutes();
      const day = istDate.getDay(); // 0 is Sunday, 6 is Saturday

      const hoursFormatted = String(hours).padStart(2, '0');
      const minutesFormatted = String(minutes).padStart(2, '0');
      
      if (clockEl) {
        clockEl.textContent = `${hoursFormatted}:${minutesFormatted} IST`;
      }

      // Check if within court hours (Mon-Fri 10:30 to 16:30 IST)
      const isWeekday = day >= 1 && day <= 5;
      const timeInMinutes = hours * 60 + minutes;
      const isInSession = isWeekday && (timeInMinutes >= 630 && timeInMinutes <= 990);

      if (textEl && pillEl) {
        if (isInSession) {
          textEl.textContent = 'TS High Court · In Session';
          pillEl.classList.remove('recess');
        } else {
          textEl.textContent = 'Chambers Hours · IST';
          pillEl.classList.add('recess');
        }
      }
    }

    updateClock();
    setInterval(updateClock, 10000);
  })();
</script>
