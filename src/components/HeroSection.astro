---
// HeroSection.astro — Bespoke Editorial Hero Component
---

<section class="hero" aria-labelledby="hero-title">
  <div class="evidence-rail reveal-left" data-delay="300">Case file / 2026</div>
  
  <div class="hero-copy reveal-init" data-delay="100">
    <div class="file-tab">Advocacy with intent</div>
    <h1 id="hero-title">A clear case begins with a <em>clear conversation.</em></h1>
    <p class="hero-summary">
      Brief &amp; Gavel is the advocate practice of Vimal Vasireddy for people who need a considered legal strategy, not intimidating legal theatre.
    </p>
    <div class="hero-actions">
      <button class="desk-button consultation-trigger" type="button">Discuss your matter ↗</button>
      <a class="desk-button ghost" href="#practice">Explore practice areas →</a>
    </div>
    <p class="hero-note">⌾ <b>Practical. Private. Prepared.</b> Start with the facts, then choose the next right step.</p>
  </div>

  <div class="hero-object reveal-right" data-delay="200">
    <img
      src="https://briefgavel-xsdpi3fq.manus.space/manus-storage/brief-gavel-hero_fb3554c6.jpg"
      alt="A considered advocate desk with a gavel, case file, pen and papers"
      width="640"
      height="555"
      loading="eager"
    />
    <span class="object-number">01</span>
    <span class="object-label">The working brief</span>
    <div class="docket-seal-stamp" aria-hidden="true">CHAMBERS COPY · TS/2026</div>
  </div>

  <aside class="hero-brief-slip reveal-scale" id="hero-brief-slip" data-delay="350">
    <div class="slip-avatar-wrap">
      <img class="slip-avatar" src="/img/vimal-vasireddy.png" alt="Vimal Vasireddy, Advocate" width="54" height="54" />
    </div>
    <span>Advocate</span>
    <strong>Vimal<br />Vasireddy</strong>
    <i>Case record / 01</i>
  </aside>
</section>
