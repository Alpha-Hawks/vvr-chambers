---
// ChambersRollPreview.astro — Showcase Grid of Chambers Advocates
import data from "../data/chambers.json";
const juniors = data.juniors.slice(0, 4); // Preview first 4 advocates
---

<section class="content-section roll-preview-section" id="roll-preview">
  <div class="section-header reveal-init">
    <div class="section-kicker">Chambers Roll · Advocates at the Bar</div>
    <div>
      <h2 class="section-title">An institution of independent, <em>rigorous counsel.</em></h2>
      <p class="section-intro">
        Juniors of these chambers practise independently and may be instructed directly under Rule 36 of the Bar Council of India Rules.
      </p>
    </div>
  </div>

  <div class="roll-cards-grid reveal-init" data-delay="150">
    {juniors.map((advocate, idx) => (
      <article class="roll-card reveal-init" data-delay={100 + (idx * 80)}>
        <div class="roll-card-header">
          <span class="roll-badge">Advocate / TS</span>
          <span class="roll-number">0{idx + 2}</span>
        </div>
        <h3 class="roll-name">{advocate.name}</h3>
        <p class="roll-designation">{advocate.designation} · {advocate.barAssociation.split(" ")[0]} High Court</p>
        <div class="roll-tags">
          {advocate.areasOfPractice.map((area) => (
            <span class="roll-tag">{area}</span>
          ))}
        </div>
        <a class="roll-action-link" href={`/chambers/${advocate.slug}`}>
          <span>View professional record</span>
          <span class="arrow">→</span>
        </a>
      </article>
    ))}
  </div>
  
  <div class="roll-footer-cta reveal-init" data-delay="300">
    <a class="desk-button ghost" href="/chambers">View Complete Chambers Roll →</a>
  </div>
</section>
