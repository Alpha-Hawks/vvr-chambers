---
// ProfileSection.astro — Advocate Profile, Credentials & Animated Statistics
---

<section class="advocate-profile" id="profile">
  <div class="profile-inner">
    <aside class="profile-record reveal-left">
      <div class="record-badge-header">
        <span>Advocate / Profile</span>
        <div class="record-seal-mark" aria-hidden="true">LEX</div>
      </div>
      <strong>Vimal<br />Vasireddy</strong>
      <p>
        Credentials and court admissions are published under the proviso to Rule 36 of the Bar Council of India Rules.
      </p>
    </aside>

    <div class="profile-content reveal-init" data-delay="150">
      <div class="section-kicker">About Vimal Vasireddy</div>
      <h2 class="section-title">A steady hand when the stakes are <em>highest.</em></h2>
      <p class="profile-note">
        Advocacy is not theatrical performance; it is structured logic built upon an uncompromising grasp of the record. We appear in constitutional petitions, appellate litigation, and domestic arbitration before the High Court of Telangana, Andhra Pradesh High Court, and NCLT.
      </p>

      <div class="credential-grid">
        <article class="credential-card reveal-init" data-delay="100">
          <span>Bar enrolment</span>
          <strong>TS/0000/0000</strong>
        </article>
        <article class="credential-card reveal-init" data-delay="200">
          <span>Years in practice</span>
          <strong>14+ Years</strong>
        </article>
        <article class="credential-card reveal-init" data-delay="300">
          <span>Courts admitted</span>
          <strong>Telangana High Court, AP High Court &amp; NCLT</strong>
        </article>
        <article class="credential-card reveal-init" data-delay="400">
          <span>Recognitions</span>
          <strong>High Court Bar Association</strong>
        </article>
      </div>

      <div class="stats-docket reveal-init" data-delay="300">
        <div class="stat-item">
          <span class="stat-num" data-target="14" data-suffix="+">0</span>
          <span class="stat-label">Years at the Bar</span>
          <small class="stat-suffix">Active Practice</small>
        </div>
        <div class="stat-item">
          <span class="stat-num" data-target="3" data-suffix="">0</span>
          <span class="stat-label">Primary Forums</span>
          <small class="stat-suffix">High Courts &amp; NCLT</small>
        </div>
        <div class="stat-item">
          <span class="stat-num" data-target="500" data-suffix="+">0</span>
          <span class="stat-label">Briefs Argued</span>
          <small class="stat-suffix">Matters Prepared</small>
        </div>
        <div class="stat-item">
          <span class="stat-num" data-target="100" data-suffix="%">0</span>
          <span class="stat-label">Privilege &amp; Discretion</span>
          <small class="stat-suffix">BCI Compliant</small>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function initStatsCounter() {
    const statElements = document.querySelectorAll('.stat-num');
    let animated = false;

    function animateCounters() {
      if (animated) return;
      const statsSection = document.querySelector('.stats-docket');
      if (!statsSection) return;

      const rect = statsSection.getBoundingClientRect();
      if (rect.top <= window.innerHeight * 0.85 && rect.bottom >= 0) {
        animated = true;
        statElements.forEach(el => {
          const target = parseInt(el.getAttribute('data-target') || '0', 10);
          const suffix = el.getAttribute('data-suffix') || '';
          let current = 0;
          const step = Math.max(1, Math.floor(target / 45));
          const interval = setInterval(() => {
            current += step;
            if (current >= target) {
              el.textContent = target + suffix;
              clearInterval(interval);
            } else {
              el.textContent = current + suffix;
            }
          }, 30);
        });
      }
    }

    window.addEventListener('scroll', animateCounters, { passive: true });
    setTimeout(animateCounters, 600);
  })();
</script>
